/.phpunit.result.cache
/phpunit.xml.bak
/storage/pail
/storage/debugbar
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!storage/framework/.gitignore
!storage/logs/.gitignore
/bootstrap/cache/*.php
/storage/*.tmp
/storage/*.txt
/storage/*.json

# Berkas kerja pengujian & debug lokal
/*.bat
/*.ps1
!/tests/ApiSmokeTest.ps1
*.bak
*.orig

